{
  // Use local Biome schema from node_modules
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  // Respect .gitignore (skips dist/, node_modules/, .turbo/, etc.). Fixtures
  // and tree templates are data, not source: vendored or hand-made trees are
  // kept byte-for-byte.
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!.claude", "!fixtures", "!packages/okforest/templates"]
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "noDuplicateClasses": "on"
      }
    }
  },

  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },

  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  }
}
